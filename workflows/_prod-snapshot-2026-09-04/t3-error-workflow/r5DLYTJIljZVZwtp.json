  {
   "parameters": {
    "jsCode": "const body = $input.first().json?.body || {};\nlet limit = 10;\ntry {\n  if (body.limit !== undefined && body.limit !== null) {\n    const parsed = parseInt(String(body.limit), 10);\n    if (!isNaN(parsed)) limit = Math.max(1, Math.min(20, parsed));\n  }\n} catch(e) {}\nconst VALID_FOLDERS = ['inbox', 'junkemail', 'deleteditems', 'sentItems', 'drafts', 'archive'];\nconst rawFolder = String(body.folder || 'inbox').trim();\nconst folder = VALID_FOLDERS.includes(rawFolder) ? rawFolder : 'inbox';\nreturn [{ json: { limit, folder } }];"
   },
   "id": "82e66904-9ad7-4d00-84ff-d21a9108ab18",
