   "id": "e610c9dc-72f0-4167-9c8c-417f42051fa1",
   "name": "Message Telegram",
   "type": "n8n-nodes-base.telegramTrigger",
   "typeVersion": 1,
   "position": [
    368,
    -320
   ],
   "webhookId": "telegram-jarvis",
   "credentials": {
    "telegramApi": {
     "id": "2eYIQNs1zgDy76a0",
     "name": "Jarvis Telegram Bot"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "const msg = $input.first().json;\nconst text = msg.message?.text || '';\nconst chat_id = msg.message?.chat?.id;\nconst from = msg.message?.from?.first_name || 'Inconnu';\nif (!text || !chat_id) return [];\nreturn [{ json: { text, chat_id, from } }];"
   },
   "id": "2e85b8d0-8e12-476f-9c68-a8090e80255e",
   "name": "Extraire message",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    592,
    -320
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ ($env.BACKEND_URL || 'http://backend:8000') + '/api/chat' }}",
    "sendBody": true,
    "bodyParameters": {
     "parameters": [
      {
       "name": "text",
       "value": "={{ $json.text }}"
      }
     ]
    },
    "options": {
     "timeout": 30000
    }
   },
   "id": "217ed04f-092c-4320-b5d1-532aad53539a",
   "name": "Appeler Jarvis",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    816,
    -320
   ],
   "continueOnFail": true
  },
  {
   "parameters": {
    "jsCode": "const jarvisResp = $('Appeler Jarvis').first().json;\nconst chatId = $('Extraire message').first().json.chat_id;\nconst response = jarvisResp.response || jarvisResp.detail || 'Erreur — Jarvis est injoignable.';\nconst MAX = 4096;\nconst chunks = [];\nfor (let i = 0; i < response.length; i += MAX) {\n  chunks.push({ json: { chat_id: chatId, text: response.slice(i, i + MAX) } });\n}\nreturn chunks.length ? chunks : [{ json: { chat_id: chatId, text: 'Erreur — réponse vide.' } }];"
   },
   "id": "a99bcd59-3ab5-416a-af9b-64838c93213d",
   "name": "Préparer réponse",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1040,
    -320
   ]
  },
  {
   "parameters": {
    "chatId": "={{ $json.chat_id }}",
    "text": "={{ $json.text }}",
    "additionalFields": {
     "parse_mode": "Markdown"
    }
   },
