   "webhookId": "outlook-search"
  },
  {
   "parameters": {
    "jsCode": "const body = $input.first().json.body || {};\nconst q = String(body.q || '').trim();\nconst limit = Math.max(1, Math.min(50, parseInt(String(body.limit || 10), 10) || 10));\nconst dateFrom = String(body.date_from || '').trim();\nlet url = `https://graph.microsoft.com/v1.0/me/messages?$top=${limit}&$select=id,subject,from,receivedDateTime,bodyPreview,importance`;\nif (q) {\n  url += `&$search=\"${encodeURIComponent(q)}\"`;\n} else {\n  url += '&$orderby=receivedDateTime desc';\n  if (dateFrom) url += `&$filter=receivedDateTime ge ${dateFrom}T00:00:00Z`;\n}\nreturn [{ json: { url, q, limit } }];"
   },
   "id": "8b9cd579-c6c4-4427-9753-d43fec29d176",
   "name": "Configuration",
   "type": "n8n-nodes-base.code",
