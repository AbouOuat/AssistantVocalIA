   ],
   "credentials": {
    "openAiApi": {
     "id": "aNQ7WpgQ7Tm2YyGg",
     "name": "OpenAI account"
    },
    "httpHeaderAuth": {
     "id": "F99p27Ao9ucj5aeX",
     "name": "Header Auth account"
    }
   },
   "continueOnFail": true
  },
  {
   "parameters": {
    "jsCode": "let parsed;\ntry {\n  const content = $json.choices?.[0]?.message?.content || '{}';\n  parsed = JSON.parse(content);\n} catch(e) {\n  parsed = { action_plan: ['Erreur analyse — reessaie en reformulant tes notes.'], email_draft: null, summary: 'Analyse echouee.' };\n}\nreturn [{ json: parsed }];"
   },
