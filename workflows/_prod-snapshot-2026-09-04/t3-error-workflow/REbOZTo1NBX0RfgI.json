  {
   "parameters": {
    "jsCode": "const notes = $input.first().json.body?.notes || '';\nconst payload = {\n  model: 'gpt-4o',\n  temperature: 0.3,\n  response_format: { type: 'json_object' },\n  messages: [\n    {\n      role: 'system',\n      content: 'Tu es Jarvis, expert en productivite. Analyse les notes et genere un plan d action. Reponds UNIQUEMENT en JSON valide avec : action_plan (array de strings, 3-5 etapes prioritisees), email_draft (objet {subject, body} ou null si pas necessaire), summary (string, 1 phrase).'\n    },\n    {\n      role: 'user',\n      content: 'Analyse ces notes :\\n\\n' + notes\n    }\n  ]\n};\nreturn [{ json: { body: JSON.stringify(payload), notes } }];"
   },
   "id": "4ee18585-ac68-47c8-ae15-9bc893e3a241",
   "name": "Préparer requête",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -4048,
    -1936
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://api.openai.com/v1/chat/completions",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "openAiApi",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ $json.body }}",
    "options": {}
   },
   "id": "428ec31a-5f02-4802-99d4-a95dedde27a4",
   "name": "Analyser avec GPT-4o",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
